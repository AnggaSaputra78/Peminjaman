<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Verifikasi Peminjaman</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center">
  <div class="bg-white p-8 rounded-xl shadow-lg w-full max-w-md">
    <div class="text-center mb-6">
      <i class="fas fa-qrcode text-4xl <%= valid ? 'text-green-500' : 'text-red-500' %> mb-2"></i>
      <h1 class="text-2xl font-bold text-gray-800">Verifikasi Peminjaman</h1>
    </div>

    <% if (valid) { %>
      <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-4">
        <div class="flex items-center">
          <i class="fas fa-check-circle text-green-500 text-xl mr-2"></i>
          <span class="text-green-700 font-semibold">Data Valid</span>
        </div>
      </div>

      <div class="space-y-3 text-sm">
        <div class="flex justify-between">
          <span class="text-gray-600">ID Peminjaman:</span>
          <span class="font-mono"><%= peminjaman.id %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">Nama Peminjam:</span>
          <span class="font-semibold"><%= peminjaman.borrower_name %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">Device:</span>
          <span><%= peminjaman.device_name %> (<%= peminjaman.device_type %>)</span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">Tanggal Pinjam:</span>
          <span><%= peminjaman.borrow_date %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">Status:</span>
          <span class="<%= peminjaman.status === 'returned' ? 'text-green-600' : 'text-yellow-600' %> font-semibold">
            <%= peminjaman.status === 'returned' ? 'Telah Dikembalikan' : 'Masih Dipinjam' %>
          </span>
        </div>
      </div>

    <% } else { %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-4">
        <div class="flex items-center">
          <i class="fas fa-times-circle text-red-500 text-xl mr-2"></i>
          <span class="text-red-700 font-semibold">Data Tidak Valid</span>
        </div>
        <p class="text-red-600 text-sm mt-1"><%= message %></p>
      </div>
    <% } %>

    <div class="mt-6 text-center">
      <a href="/" class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600">
        <i class="fas fa-home mr-2"></i>Kembali ke Home
      </a>
    </div>
  </div>
</body>
</html>