<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Tambah Device</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 p-6">
  <div class="max-w-md mx-auto bg-white p-6 rounded shadow">
    <h2 class="text-xl font-bold mb-4">Tambah Device</h2>

    <form action="/add" method="POST" enctype="multipart/form-data" class="space-y-4">
      <!-- Nama Device -->
      <input type="text" name="name" placeholder="Nama Device" 
             class="w-full border px-3 py-2 rounded" required>

      <!-- Jenis Device -->
      <input type="text" name="type" placeholder="Jenis Device" 
             class="w-full border px-3 py-2 rounded" required>
      
      <!-- Upload Foto -->
      <label class="block text-gray-700">Upload Foto:</label>
      <input type="file" name="photo" accept="image/*" 
             class="w-full border px-3 py-2 rounded">

      <!-- Upload QR Code -->
      <label class="block text-gray-700">Upload QR Code:</label>
      <input type="file" name="qrcode" accept="image/*" 
             class="w-full border px-3 py-2 rounded">

      <!-- Tombol Simpan -->
      <button type="submit" 
              class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600">
        Simpan
      </button>
    </form>

    <a href="/" class="text-blue-500 mt-4 inline-block hover:underline">Kembali</a>
  </div>
</body>
</html>
